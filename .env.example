APP_ENV=development
APP_NAME=TG Support Hub
APP_SECRET=replace-with-random-secret
APP_JWT_SECRET=replace-with-random-jwt-secret
APP_JWT_TTL_MINUTES=720
AUTO_CREATE_TABLES=true
# On startup, also ADD COLUMN for any column declared in models but
# missing in the live DB. Inherits AUTO_CREATE_TABLES if unset.
AUTO_MIGRATE_COLUMNS=true

# Use "mariadb" when running the bundled compose service; use
# "host.docker.internal" when connecting to MariaDB installed on the host.
MYSQL_HOST=mariadb
MYSQL_PORT=3306
MYSQL_DATABASE=tg_support_hub
MYSQL_USER=tg_support
MYSQL_PASSWORD=replace-with-strong-password
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password

# Use "redis" when running the bundled compose service; use
# "host.docker.internal" when connecting to Redis installed on the host.
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-strong-password
REDIS_DB=0

TELEGRAM_API_ID=
TELEGRAM_API_HASH=

SESSION_DIR=/app/data/sessions
UPLOAD_DIR=/app/data/uploads
LOG_DIR=/app/data/logs

# Dispatch / send-worker defaults
DISPATCH_BATCH_SIZE=50
DISPATCH_LOCK_TTL_PADDING=30
MAX_FAILED_ATTEMPTS=3
